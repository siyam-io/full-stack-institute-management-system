{
  "name": "institute-management-system-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "prisma generate",
    "postinstall": "prisma generate",
    "dev": "nodemon index.js",
    "start": "node index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:generate:pg": "prisma generate --schema prisma/schema.postgres.prisma",
    "prisma:migrate:pg": "prisma migrate dev --schema prisma/schema.postgres.prisma --name init",
    "prisma:studio": "prisma studio",
    "prisma:studio:pg": "prisma studio --schema prisma/schema.postgres.prisma",
    "db:migrate:pg": "prisma migrate dev --schema prisma/schema.postgres.prisma",
    "db:generate:pg": "prisma generate --schema prisma/schema.postgres.prisma",
    "db:migrate:mysql": "prisma migrate dev --schema prisma/schema.mysql.prisma",
    "db:generate:mysql": "prisma generate --schema prisma/schema.mysql.prisma",
    "seed": "node prisma/seed.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "date-fns": "^3.0.0",
    "date-fns-tz": "^3.0.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.7",
    "pdfkit": "^0.13.0",
    "qrcode": "^1.5.3",
    "validator": "^13.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prisma": "^6.0.0",
    "supertest": "^6.3.3"
  }
}
