# web2 Frontend Environment Variables
# Copy this file to .env and adjust for your setup.

# API base URL (backend)
VITE_API_URL=http://localhost:3043/api

# Image/storage base URL (for upload paths like /uploads/...)
VITE_IMAGE_URL=http://localhost:3043

# Frontend URL (used in email links, QR codes, etc.)
VITE_FRONTEND_URL=https://verification.cibdhk.com

# Main site URL
VITE_MAIN_URL=https://cibdhk.com
